# ─────────────────────────────────────────────
# Dolphin AI — required environment variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# PostgreSQL connection string (required for the API server and DB migrations)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Secret used to sign session cookies (any long random string works)
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
